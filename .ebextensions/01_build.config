commands:
  01_system_packages:
    command: yum install -y gcc git python3-devel postgresql-devel

  02_install_node:
    command: |
      set -euo pipefail
      node_is_compatible() {
        command -v node >/dev/null 2>&1 && node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major === 22 && minor >= 12 ? 0 : 1)'
      }
      if ! node_is_compatible; then
        curl -fsSL https://rpm.nodesource.com/setup_22.x | bash -
        # A higher RPM epoch on Node 20 can make Node 22 a package downgrade.
        # An explicit version lets DNF replace it in either direction.
        dnf install -y --refresh --best 'nodejs-22.*'
        hash -r
      fi
      if ! node_is_compatible; then
        echo "Node 22.12.0 or newer within Node 22 is required" >&2
        exit 1
      fi
      node --version
      npm install --global pnpm@9.15.9
      pnpm --version
      test "$(pnpm --version)" = "9.15.9"

  03_install_rsync:
    command: |
      set -euo pipefail
      yum install -y rsync

container_commands:
  01_install_client_deps:
    command: |
      set -euo pipefail
      node --version
      pnpm --version
      test "$(pnpm --version)" = "9.15.9"
      pnpm install --frozen-lockfile --prod=false

  02_build_client:
    command: |
      set -euo pipefail
      pnpm --filter client run build

  03_sync_build_into_server:
    command: |
      set -euo pipefail
      TARGET="server/src/metakb/build"
      mkdir -p "$TARGET"
      SRC="client/dist/"
      rsync -a --delete "$SRC" "$TARGET/"

  04_install_server_package:
    command: |
      set -euo pipefail
      cd server
      pip install .
